# ERP 首页或登录页。生产环境应使用 HTTPS。
MAIN_VITE_ERP_URL=http://jlbj.qianyiyun.net/Login.aspx

# 可选：使用英文逗号分隔额外允许跳转的认证域名，例如企业 SSO。
MAIN_VITE_ALLOWED_ORIGINS=https://sso.example.com

# Qwen OCR 使用阿里云百炼北京地域 OpenAI 兼容接口。
MAIN_VITE_PI_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MAIN_VITE_PI_OCR_MODEL=qwen3.5-ocr
MAIN_VITE_PI_OCR_CONTEXT_WINDOW=65536

# 字段标准化模型与 OCR 共用阿里云百炼北京地域接口和同一个 Key。
MAIN_VITE_PI_NORMALIZER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MAIN_VITE_PI_NORMALIZER_MODEL=deepseek-v4-flash-0731
MAIN_VITE_PI_NORMALIZER_CONTEXT_WINDOW=1000000
# 可选：true 开启思考，false 关闭；不配置/留空则不发送参数，沿用服务端默认值。
# 仅影响 normalizer，开发和生产均生效；修改后重启开发进程，发行版需重新构建打包。
# MAIN_VITE_PI_NORMALIZER_ENABLE_THINKING=false

# 本地预处理及单次模型请求限制。
MAIN_VITE_PI_MAX_UPLOAD_MB=100
MAIN_VITE_PI_MAX_PAGES=50
MAIN_VITE_PI_OCR_CONCURRENCY=8
# 单次文档的标准化并发上限默认 min(4, 总上限)，总上限默认沿用 OCR 上限。
# 两阶段实际在途数量之和不能超过总上限；默认 OCR 8、标准化 4、合计最多 8。
# MAIN_VITE_PI_NORMALIZER_CONCURRENCY=4
# MAIN_VITE_PI_MODEL_CONCURRENCY=8
MAIN_VITE_PI_PAGE_TIMEOUT_MS=180000
MAIN_VITE_PI_NORMALIZATION_TIMEOUT_MS=180000

# 开发环境默认打印性能统计；设为 0 关闭。生产构建始终不打印这些诊断日志。
# 日志只含耗时、token 和数量等统计，不含 OCR 原文、工具参数或思考正文。
ERP_PERFORMANCE_LOG=1
# 独立 thinking A/B（合成文本、真实模型调用；本命令由 Node 将 .env 注入环境）：
# node --env-file=.env scripts/normalizer-thinking-ab.mjs --runs 3
# 此脚本的 enable_thinking 对照不会改变应用的模型请求配置。

DASHSCOPE_API_KEY=sk-ws-H.EXHPRMP.RiJU.MEUCIFRCJ6x4TT6qaloGPXitcIXYYI9esWng-O20lC2X3txDAiEAo6i1slbZ3xUKuLBdVs90Dy-SKVBj6UBkP8nLTcz0Abk
# API Key 不要使用 MAIN_VITE_ 前缀，也不要把实际值写入 .env.example。
# 内部发行构建会把本地 .env 中的 DASHSCOPE_API_KEY 仅编译进主进程，
# 也可以在启动前通过进程环境变量设置同名变量来覆盖内置值。
# 仍兼容 PI_API_KEY，或分别设置 PI_OCR_API_KEY 和 PI_NORMALIZER_API_KEY。
